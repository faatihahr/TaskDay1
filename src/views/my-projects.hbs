<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width,initial-scale=1.0">
    <link rel="stylesheet" href="src/style.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caprasimo&family=Dancing+Script:wght@400..700&family=Vollkorn:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.4.1/dist/tailwind.min.css" rel="stylesheet">
    <title>{{title}}</title>
</head>
<body class="gradient-body">
    <header>
        <h1><i class="fa-solid fa-star-half"></i>My Digital Art Portofolio<i class="fa-solid fa-star-half fa-flip-horizontal"></i></h1>
        <p>Showcasing my aesthetic creations </p>
        <nav class="navbar navbar-expand-md bg-white bg-opacity-75 shadow-sm py-2">
            <div class="container justify-content-center">
                <a class="navbar-brand d-none" href="#"></a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar" aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
                    <ul class="navbar-nav gap-2">
                        <li class="nav-item">
                            <a class="nav-link custom-nav-link px-4 py-2 rounded-2 active" {{#if (eq activePage 'home')}}active{{/if}} href="/home" id="home-link">Home</a>
                        </li>
                        {{#if isAdmin}}
                          <li class="nav-item">
                            <a class="nav-link custom-nav-link px-4 py-2 rounded-2 {{#if (eq activePage 'my-projects')}}active{{/if}}" href="/my-projects" id="projects-link">My Projects</a>
                          </li>
                        {{/if}}
                        <li class="nav-item">
                             <a class="nav-link custom-nav-link px-4 py-2 rounded-2" {{#if (eq activePage 'contact')}}active{{/if}} href="/contact" id="contact-link">Contact</a>
                        </li>
                        <li class="nav-item">
                             <a class="nav-link custom-nav-link px-4 py-2 rounded-2 " {{#if (eq activePage 'profile')}}active{{/if}} href="/profile" id="profile-link">Profile</a>
                        </li>
                        {{#if isAdmin}}
                          <li class="nav-item">
                            <a class="nav-link custom-nav-link px-4 py-2 rounded-2 {{#if (eq activePage 'my-projects')}}active{{/if}}" href="/logout" id="projects-link">Logout</a>
                          </li>
                        {{/if}}
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <section id="add-art-section">
        <h2>Add New Art</h2>
        <form id="add-art-form" action="/add-art" method="POST" enctype="multipart/form-data">
            <label for="art-title">Title:</label>
            <input type="text" id="art-title" name="art-title" required><br>
            <label for="art-image">Image:</label>
            <input type="file" id="art-image" name="art-image" accept="image/*" required><br>
            <label for="art-description">Description:</label>
            <textarea id="art-description" name="art-description" required></textarea><br>
            <button type="submit">Add Art</button>
        </form>
    </section>
    <section id="edit-art-section">
  <h2>Edit Art</h2>
  <form id="edit-art-form" action="/edit-art" method="POST" enctype="multipart/form-data" style="display:none;">
    <input type="hidden" id="old-title" name="old-title">
    <label for="edit-art-title">Title:</label>
    <input type="text" id="edit-art-title" name="title" required><br>
    <label for="edit-art-image">Image:</label>
    <input type="file" id="edit-art-image" name="image" accept="image/*"><br>
    <label for="edit-art-description">Description:</label>
    <textarea id="edit-art-description" name="description" required></textarea><br>
    <button type="submit">Update Art</button>
  </form>
</section>

<section id="arts-list">
  <h2>Art List</h2>
  <ul>
    {{#each arts}}
      <li>
        <strong>{{title}}</strong>
        <div class="art-actions">
          <button class="edit-btn"
                  data-id="{{id}}"
                  data-title="{{title}}"
                  data-description="{{description}}"
                  data-image="{{image}}">Edit</button>
          <button class="btn btn-danger btn-sm delete-art-btn"
                  data-id="{{id}}">Delete</button>
        </div>
      </li>
    {{/each}}
  </ul>
</section>

<footer id="contact-footer" class="text-center py-6 bg-blue-100 mt-8">
    <p class="text-blue-800 mb-4">&copy; 2025 Faatihah. All rights reserved.</p>
    <p class="text-blue-800 mb-4">CONTACT ME HERE!</p>
    <div class="flex justify-center space-x-6">
        <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://instagram.com/faatihahr__" target="_blank">
                <i class="fab fa-instagram"></i>
            </a>
            <a class="text-blue-600 hover:text-blue-800 text-2xl" href="mailto:fahraaraa@gmail.com">
                <i class="fas fa-envelope"></i>
            </a>
            <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://wa.me/6281234567890" target="_blank">
                <i class="fab fa-whatsapp"></i>
            </a>
        </div>
    </footer>
    <script type= "module" src="scripts/main.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>