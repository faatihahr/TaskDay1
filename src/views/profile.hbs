        <div class="flex justify-center space-x-6">
            <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://instagram.com/faatihahr__" target="_blank">
                <i class="fab fa-instagram"></i>
            </a>
            <a class="text-blue-600 hover:text-blue-800 text-2xl" href="mailto:fahraaraa@gmail.com">
                <i class="fas fa-envelope"></i>
            </a>
            <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://wa.me/6281234567890" target="_blank">
                <i class="fab fa-whatsapp"></i>
            </a>
        </div>
