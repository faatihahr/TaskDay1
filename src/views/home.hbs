<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width,initial-scale=1.0">
  <title>{{title}}</title>

  <link rel="stylesheet" href="/src/style.css">
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@3.4.1/dist/tailwind.min.css" rel="stylesheet">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Bree+Serif&family=Caprasimo&family=Dancing+Script:wght@400..700&family=Vollkorn:ital,wght@0,400..900;1,400..900&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.1/css/all.min.css">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
  
</head>

<body class="gradient-body">
  <header>
    <h1><i class="fa-solid fa-star-half"></i> My Digital Art Portfolio <i class="fa-solid fa-star-half fa-flip-horizontal"></i></h1>
    <p>Showcasing my aesthetic creations</p>

    {{!-- Navbar --}}
    <nav class="navbar navbar-expand-md bg-white bg-opacity-75 shadow-sm py-2">
      <div class="container justify-content-center">
        <a class="navbar-brand d-none" href="#"></a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar"
                aria-controls="mainNavbar" aria-expanded="false" aria-label="Toggle navigation">
          <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse justify-content-center" id="mainNavbar">
          <ul class="navbar-nav gap-2">
            <li class="nav-item">
              <a class="nav-link custom-nav-link px-4 py-2 rounded-2 active" href="/home">Home</a>
            </li>
            {{#if isAdmin}}
              <li class="nav-item">
                <a class="nav-link custom-nav-link px-4 py-2 rounded-2 {{#if (eq activePage 'my-projects')}}active{{/if}}" href="/my-projects" id="projects-link">My Projects</a>
              </li>
            {{/if}}
            <li class="nav-item">
              <a class="nav-link custom-nav-link px-4 py-2 rounded-2" href="/contact" id="contact-link">Contact</a>
            </li>
            <li class="nav-item">
              <a class="nav-link custom-nav-link px-4 py-2 rounded-2" href="/profile" id="profile-link">Profile</a>
            </li>
            {{#if isAdmin}}
              <li class="nav-item">
                <a class="nav-link custom-nav-link px-4 py-2 rounded-2 {{#if (eq activePage 'my-projects')}}active{{/if}}" href="/logout" id="projects-link">Logout</a>
              </li>
            {{/if}}
          </ul>
        </div>
      </div>
    </nav>
  </header>

  {{!-- Carousel Section --}}
  <div id="artCarouselWrapper">
    <div id="artCarousel" class="carousel slide mt-4 mb-4" data-bs-ride="carousel">
      <div class="carousel-inner" id="carousel-inner">
        {{#each arts}}
          <div class="carousel-item {{#if @first}}active{{/if}}" data-art-id="{{id}}">
            <img src="{{image}}" class="d-block w-100 h-100" alt="{{this.title}}" style="max-height: 500px; object-fit: cover;">
            <div class="carousel-caption d-none d-md-block bg-light bg-opacity-50 rounded p-2">
              <h5>{{title}}</h5>
              <p>{{description}}</p>
            </div>
          </div>
        {{/each}}     
      </div>
      <button class="carousel-control-prev" type="button" data-bs-target="#artCarousel" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
      </button>
      <button class="carousel-control-next" type="button" data-bs-target="#artCarousel" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
      </button>
    </div>
  </div>

  {{!-- Portfolio Section --}}
  <main id="portfolio" class="container my-4">
    <div class="row g-4">
      {{#if arts}}
        {{#each arts}}
        <div class="col-12 col-md-4 mb-4">
          <div class="card art-card h-100"
               data-id="{{id}}"
               data-title="{{title}}"
               data-description="{{description}}"
               data-image="{{image}}">
            <img src="{{image}}" class="card-img-top" alt="{{this.title}}">
            <div class="card-body">
              <h5 class="card-title">{{title}}</h5>
              <p class="card-text">{{description}}</p>
            </div>
          </div>
        </div>
        {{/each}}
      {{else}}
        <div class="col-12 text-center">
          <p>No art uploaded yet.</p>
        </div>
      {{/if}}
    </div>
  </main>
  <!-- Overlay Modal Detail -->
<div class="modal fade" id="artDetailModal" tabindex="-1" aria-hidden="true">
  <div class="modal-dialog modal-lg modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="artModalTitle"></h5>
        <button type="button" class="btn-close" id="modalExitBtn" aria-label="Close"></button>
      </div>
      <div class="modal-body text-center">
        <img id="artModalImage" src="" alt="" class="img-fluid mb-3">
        <p id="artModalDescription"></p>
    </div>
  </div>
</div>
</div>
  {{!-- Footer --}}
  <footer id="contact-footer" class="text-center py-6 bg-blue-100 mt-8">
    <p class="text-blue-800 mb-4">&copy; 2025 Faatihah. All rights reserved.</p>
    <p class="text-blue-800 mb-4">CONTACT ME HERE!</p>
    <div class="flex justify-center space-x-6">
      <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://instagram.com/faatihahr__" target="_blank">
        <i class="fab fa-instagram"></i>
      </a>
      <a class="text-blue-600 hover:text-blue-800 text-2xl" href="mailto:fahraaraa@gmail.com">
        <i class="fas fa-envelope"></i>
      </a>
      <a class="text-blue-600 hover:text-blue-800 text-2xl" href="https://wa.me/6281234567890" target="_blank">
        <i class="fab fa-whatsapp"></i>
      </a>
    </div>
  </footer>
  </footer>
  {{!-- Scripts --}}
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
  <script type="module" src="/scripts/main.js"></script>
</body>
</html>
</html>
